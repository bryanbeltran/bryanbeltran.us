# Dependency trees and package-manager caches
**/node_modules/
**/.pnp/
**/.pnpm-store/
**/.yarn/cache/
**/.npm/
**/.bun/

# Dependency lockfiles (keep these tracked; omit them from agent context)
**/package-lock.json
**/npm-shrinkwrap.json
**/pnpm-lock.yaml
**/yarn.lock
**/bun.lock
**/bun.lockb
**/Cargo.lock
**/Gemfile.lock
**/Pipfile.lock
**/poetry.lock
**/uv.lock
**/composer.lock
**/mix.lock
**/pubspec.lock
**/Podfile.lock
**/Package.resolved
**/go.sum

# Build output and test reports
**/.next/
**/dist/
**/build/
**/out/
**/target/
**/.build/
**/coverage/
**/htmlcov/
**/.nyc_output/
**/playwright-report/
**/test-results/
**/storybook-static/
**/coverage.xml
**/junit.xml

# Generated code and generated framework metadata
**/generated/
**/__generated__/
**/*.generated.*
**/next-env.d.ts
**/*.tsbuildinfo
**/.contentlayer/
**/contentlayer/

# Caches, local runtime state, and editor metadata
**/.cache/
**/.turbo/
**/.parcel-cache/
**/.vite/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/__pycache__/
**/.venv/
**/venv/
**/.gradle/
**/.swiftpm/
**/.vercel/
**/.seedstarter/
**/.git/
**/.idea/
**/.vscode/
**/.cursor/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~

# Logs and temporary output
**/logs/
**/tmp/
**/temp/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Local secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*secrets*

